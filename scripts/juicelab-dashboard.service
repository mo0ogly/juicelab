[Unit]
Description=JuiceLab teacher dashboard (Flask)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adapter ces deux chemins a ton install :
WorkingDirectory=/home/fpizzi/juice/dashboard
EnvironmentFile=/home/fpizzi/juice/docker/.env
# Override : ecouter sur toutes les interfaces (LAN). Production VPS = 127.0.0.1 + reverse proxy.
Environment=DASHBOARD_BIND=0.0.0.0
ExecStart=/usr/bin/python3 app.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/fpizzi/juice/dashboard/dashboard.log
StandardError=append:/home/fpizzi/juice/dashboard/dashboard.log

[Install]
WantedBy=default.target

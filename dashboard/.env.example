# JuiceLab dashboard env vars (local dev, copy to .env). When the dashboard
# runs via docker compose, set the same values in docker/.env instead.

# ---- Required for the dashboard to serve at all ----
# Token used to gate /dashboard, /api/cohort, /api/admin/* — share with the
# prof, never with students. Must be >= 16 chars.
DASHBOARD_TEACHER_TOKEN=replace-me-with-32+-random-chars

# Used to sign tamper-evident /api/proof markdown bundles. Never commit.
DASHBOARD_PROOF_SECRET=replace-me-with-another-32+-random-secret

# ---- Required for /api/verify-flag (juicelab Coach +10 bonus) ----
# Same content as juice-shop/ctf.key. juice.ps1 sets this automatically.
JUICESHOP_CTF_SECRET=

# ---- CTFd integration (Mode C, OPT-IN, leave empty for Mode A or B) ----
# When CTFD_URL and CTFD_ADMIN_TOKEN are BOTH set and non-empty, the
# dashboard pushes a negative award to CTFd on every hint_revealed event,
# so the public CTFd leaderboard reflects the actual pedagogical effort.
# Leave both empty for the default local-only deployment (no CTFd).
CTFD_URL=
CTFD_ADMIN_TOKEN=
# Penalty formula : mirror_juicelab (default, value = -cost_pct, e.g. N5
# = -50pts) or uniform_10pct (value = -10pts whatever the level).
CTFD_PENALTY_FORMULA=mirror_juicelab
# CTFd team mode : team (default) pushes awards to a team_id, user pushes
# to a user_id. Match the configured CTFd instance.
CTFD_TEAM_MODE=team

# ---- Dashboard server tuning ----
DASHBOARD_DB=./data/dashboard.sqlite
DASHBOARD_PORT=5000
DASHBOARD_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DASHBOARD_LOG_LEVEL=INFO
DASHBOARD_DEFAULT_COHORT=M2-IA-2026

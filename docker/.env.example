# JuiceLab environment variables (copy to .env and edit before deploy).
# .env doit etre AJOUTE dans docker/.dockerignore et .gitignore.

# Token prof pour acceder au dashboard et a l'admin endpoint Juice Shop.
# Doit faire >= 16 caracteres et etre PARTAGE entre les containers et le prof.
TEACHER_ADMIN_TOKEN=replace-me-with-32+-random-chars
DASHBOARD_TEACHER_TOKEN=replace-me-with-32+-random-chars

# Secret HMAC (>= 16 chars) qui signe les preuves de progression et les
# diplomes (mode solo / dashboard local). Genere automatiquement par
# install-student.sh. Sans lui, /api/proof et /api/diploma renvoient 503
# mais le reste du dashboard fonctionne.
DASHBOARD_PROOF_SECRET=replace-me-with-32+-random-chars

# Secret CTF partage avec le serveur Juice Shop (config ctf.key cote
# juice-shop). Active la verification de flag (/api/verify-flag). Laisser
# vide desactive uniquement la verif de flag. NE PAS inventer : doit etre
# identique a la cle du Juice Shop cible.
# JUICESHOP_CTF_SECRET=

# Cohorte logique (regroupe les eleves dans le dashboard).
# Choisir un identifiant stable, par ex. M2-IA-2026, M1-CYBER-2026, etc.
JUICELAB_COHORT_ID=replace-me-with-cohort-id

# Langue par defaut du plugin.
JUICELAB_DEFAULT_LANGUAGE=fr

# Origines autorisees a poster vers le dashboard. Pour une cohorte locale,
# laisser localhost:3000. Pour un deploiement multi-instance avec ports,
# lister tous les ports : http://127.0.0.1:3001,http://127.0.0.1:3002,...
DASHBOARD_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Port du dashboard.
DASHBOARD_PORT=5050

# Le frontend Angular pointe vers cette URL pour envoyer les events.
# Doit etre l'URL VISIBLE depuis le navigateur de l'eleve, pas depuis
# le reseau Docker interne. Si tu deploies sur un VPS, mettre
# http://td.juicelab.tld:5000 ou similaire.
DASHBOARD_PUBLIC_HOST=127.0.0.1

# Port mappe pour l'instance demo (smoke test).
JUICELAB_DEMO_PORT=3000

# Niveau de log dashboard (DEBUG, INFO, WARNING, ERROR).
DASHBOARD_LOG_LEVEL=INFO

# ---- CTFd integration (Mode C, OPT-IN) -----------------------------------
#
# Modes de deploiement supportes :
#
#   Mode A  Standalone local par eleve — laisser CTFD_URL et
#           CTFD_ADMIN_TOKEN vides. Pas de CTFd, pas de leaderboard public.
#           Le prof recupere les proof.md a la fin (USB / email).
#
#   Mode B  Cohorte tracking via dashboard central — pareil que Mode A
#           pour CTFd (vide). Le prof voit /api/cohort en temps reel.
#
#   Mode C  Mode A ou B + CTFd central pour la competition. CTFD_URL
#           pointe vers le serveur CTFd et CTFD_ADMIN_TOKEN est un token
#           d'admin valide. Chaque hint juicelab declenche un award
#           negatif sur CTFd, le leaderboard reflete l'effort reel.
#
# Pour activer Mode C, decommenter et remplir les 4 lignes ci-dessous
# ET decommenter le service `ctfd` dans docker-compose.yml (si CTFd local).

# CTFD_URL=http://127.0.0.1:8000
# CTFD_ADMIN_TOKEN=ctfd_xxxxxxxxxxxxxxxxxxxxxxxx

# Formule de penalite : mirror_juicelab (default, -cost_pct, e.g. N5=-50)
# ou uniform_10pct (-10 par hint quel que soit le niveau).
# CTFD_PENALTY_FORMULA=mirror_juicelab

# Mode CTFd : team (default) ou user. Aligner avec la config du serveur CTFd.
# CTFD_TEAM_MODE=team

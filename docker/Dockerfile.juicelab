# JuiceLab Juice Shop image. Self-contained build : clones OWASP Juice Shop
# at a pinned commit inside the builder stage, layers the JuiceLab overlay
# on top, applies the core patch, and produces a slim runtime image.
#
# Build context : repository root (one level above this file).
#
#   docker build -f docker/Dockerfile.juicelab -t juicelab:latest .
#
# Runtime env vars (set via docker-compose):
#   TEACHER_ADMIN_TOKEN          long secret enabling /api/juicelab/admin/state
#   JUICELAB_DASHBOARD_URL       baked into config.json at deploy time via
#                                docker-compose (overrides the file already
#                                shipped in the image)
#   JUICELAB_COHORT_ID           cohort label
#   JUICELAB_INSTANCE_LABEL      uniquely identifies this container in the
#                                dashboard (e.g. td-amelie, td-bobby)
#
# Build-time args (override with --build-arg) :
#   JUICE_SHOP_REPO    Upstream OWASP Juice Shop URL (default : juice-shop/juice-shop)
#   JUICE_SHOP_COMMIT  Pinned commit hash the JuiceLab patch was generated against
#                      (default : 3b178fd, the upstream commit "Add update
#                      mechanism back for legacy website"). Bump together with
#                      a regenerated patches/juicelab-core.patch when rebasing.

FROM node:24-bullseye AS builder
WORKDIR /build

# git is required for the clone + apply --3way step. ca-certificates is
# needed for the HTTPS clone.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

ARG JUICE_SHOP_REPO=https://github.com/juice-shop/juice-shop.git
ARG JUICE_SHOP_COMMIT=3b178fd

# Clone the pinned upstream tree. We do not use --depth 1 because git
# apply --3way needs blob ancestry to resolve context drift.
RUN git clone "${JUICE_SHOP_REPO}" /build/juice-shop && \
    cd /build/juice-shop && \
    git checkout "${JUICE_SHOP_COMMIT}"

# Layer the JuiceLab overlay (new files only — every file here is owned
# by JuiceLab and never appears upstream). Docker COPY merges directories
# recursively, so juice-shop/data/ gains a juicelab-private/ subdirectory,
# juice-shop/frontend/src/app/ gains a juicelab-overlay/ subdirectory, etc.
COPY overlay/. /build/juice-shop/

# Apply the patch that wires the overlay into the Juice Shop core files
# (server.ts route registration, navbar button, score-board card, i18n
# keys, config flag, ftp acquisitions). The patch is generated against
# the pinned commit above ; a different JUICE_SHOP_COMMIT may require a
# regenerated patch.
COPY patches/juicelab-core.patch /build/juicelab-core.patch
RUN cd /build/juice-shop && \
    git apply --3way /build/juicelab-core.patch && \
    rm -f /build/juicelab-core.patch

# Install root deps (triggers the frontend build via the postinstall pipeline
# declared in juice-shop/package.json) and compile the TypeScript backend.
WORKDIR /build/juice-shop
RUN npm install --unsafe-perm 2>&1 | tail -20
RUN npm run build:server

# Drop dev-only artefacts after build to slim the runtime image
RUN rm -rf frontend/.angular frontend/node_modules .git tests cypress \
           frontend/cypress

# ---------- Runtime stage ----------
FROM node:24-bullseye-slim AS runtime
ENV NODE_ENV=production \
    PORT=3000

# tini reaps zombie children when running under docker / docker-compose
RUN apt-get update && apt-get install -y --no-install-recommends tini && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /juice-shop
COPY --from=builder /build/juice-shop /juice-shop

# Make sure the private pedagogical packs are owned by the unprivileged user
RUN useradd -m -u 1001 juicelab && \
    chown -R juicelab:juicelab /juice-shop && \
    chmod -R o-rwx /juice-shop/data/juicelab-private

USER juicelab

EXPOSE 3000

# Use tini as PID 1, then run the entrypoint that resolves config from env
COPY --chown=juicelab:juicelab docker/entrypoint.sh /usr/local/bin/juicelab-entrypoint.sh
RUN chmod +x /usr/local/bin/juicelab-entrypoint.sh

# Healthcheck : Juice Shop core exposes the rest root at / and the
# REST /rest/admin/application-version endpoint as a low-cost readiness
# probe. 60s start-period because the Angular bundle takes a moment.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3000/rest/admin/application-version', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/juicelab-entrypoint.sh"]
CMD ["node", "build/app.js"]
